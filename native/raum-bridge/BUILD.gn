# raum. Bridge – Matter-Server (Aggregator) als Android-JNI-Bibliothek libRaumBridge.so.
# Gebaut im Matter-SDK-Baum (tools/build-matter-bridge.sh kopiert dieses Verzeichnis nach
# examples/raum-bridge/android und ruft gn/ninja auf).

import("//build_overrides/build.gni")
import("//build_overrides/chip.gni")

import("${build_root}/config/android_abi.gni")

shared_library("jni") {
  output_name = "libRaumBridge"

  sources = [
    "include/CHIPProjectAppConfig.h",
    "src/BridgeIdentity.cpp",
    "src/BridgeIdentity.h",
    "src/BridgeServer.cpp",
    "src/BridgeTypes.h",
    "src/BridgedDevice.cpp",
    "src/BridgedDevice.h",
    "src/RaumClusters.cpp",
    "src/RaumClusters.h",
  ]

  include_dirs = [
    "include",
    "${chip_root}/examples/all-devices-app/all-devices-common",
  ]

  deps = [
    "${chip_root}/examples/all-devices-app/all-devices-common/devices/aggregator",
    "${chip_root}/examples/all-devices-app/all-devices-common/devices/interface:single-endpoint-device",
    "${chip_root}/examples/all-devices-app/all-devices-common/devices/root-node",
    "${chip_root}/src/app/clusters/boolean-state-server",
    "${chip_root}/src/app/clusters/bridged-device-basic-information-server",
    "${chip_root}/src/app/clusters/identify-server",
    "${chip_root}/src/app/clusters/level-control",
    "${chip_root}/src/app/clusters/network-commissioning",
    "${chip_root}/src/app/clusters/occupancy-sensor-server",
    "${chip_root}/src/app/clusters/on-off-server",
    "${chip_root}/src/app/clusters/relative-humidity-measurement-server",
    "${chip_root}/src/app/clusters/temperature-measurement-server",
    "${chip_root}/src/app/persistence",
    "${chip_root}/src/app/persistence:default",
    "${chip_root}/src/app/server",
    "${chip_root}/src/credentials:default_attestation_verifier",
    "${chip_root}/src/data-model-providers/codedriven",
    "${chip_root}/src/lib",
    "${chip_root}/src/platform",
    "${chip_root}/src/platform/android",
    "${chip_root}/src/platform/logging:default",
    "${chip_root}/zzz_generated/app-common/devices/",
  ]

  output_dir = "${root_out_dir}/lib/jni/${android_abi}"
  ldflags = [ "-Wl,--gc-sections" ]
}

group("default") {
  deps = [ ":jni" ]
}
