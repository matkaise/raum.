<?xml version="1.0" encoding="utf-8"?>
<!--
    raum. hält alle Daten lokal (Spez. 12.4). Keine Cloud-Sicherung und keine Gerät-zu-Gerät-Übertragung
    durch Android – Sicherungen nur verschlüsselt über den Wartungsmodus (BAK-002).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
